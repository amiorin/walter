{:paths   ["src/clj" "src/resources"]
 :deps    {org.clojure/clojure              {:mvn/version "1.12.5"}
           io.github.amiorin/big-config     {:git/url "https://github.com/bigconfig-ai/big-config.git"
                                             :git/sha "2a3659e707f58eb743252c5493e7270682bb8d3d"}
           io.github.bigconfig-ai/once       {:git/url "https://github.com/bigconfig-ai/once.git"
                                              :git/sha "f73a94ded86604b8d23141ed51ac9ee8fa85cefa"}
           babashka/process                 {:mvn/version "0.6.25"}
           cheshire/cheshire                {:mvn/version "6.2.0"}
           clj-commons/clj-yaml             {:mvn/version "1.0.29"}
           metosin/malli                    {:mvn/version "0.20.1"}}
 :aliases {:dev  {:extra-paths ["env/dev/clj" "test/clj"]
                  :jvm-opts ["-Djdk.attach.allowAttachSelf=true"]}
           :test {:extra-paths ["test/clj"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}}}
