{:paths   ["src/clj" "src/resources"]
 ;; Pinned by sha so this project resolves as a git dependency elsewhere — the
 ;; launcher fetches it that way. Swap in the local roots to develop against
 ;; green or once source.
 :deps    {org.clojure/clojure          {:mvn/version "1.12.5"}
           io.github.amiorin/green      {:git/url "https://github.com/amiorin/green.git"
                                         :git/sha "fb3587ce99b1e8082dada3103c1016cde61e8b74"}
           io.github.bigconfig-ai/once  {:git/url "https://github.com/bigconfig-ai/once.git"
                                         :git/sha "b81207db1c96e8ae1e6a654bd49d45aba99594de"}
           #_#_io.github.amiorin/green  {:local/root "/home/ubuntu/code/green"}}
 :aliases {:dev  {:extra-paths ["env/dev/clj" "test/clj"]}
           :test {:extra-paths ["test/clj"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}}}
